{
  "kind": "eeip/node",
  "apiVersion": "1.0",
  "type": "PARALLEL",
  "version": "1.0.0",
  "meta": {
    "category": "control",
    "displayName": {
      "zh-CN": "并行",
      "zh-TW": "並行",
      "en-US": "Parallel"
    },
    "color": "#5C6B78",
    "size": {
      "w": 150,
      "h": 56
    },
    "order": 75,
    "summary": "多分支并行",
    "keywords": [
      "parallel",
      "并行"
    ]
  },
  "ports": {
    "inputs": [
      {
        "id": "in",
        "type": "any"
      }
    ],
    "outputs": [
      {
        "id": "branch",
        "type": "any",
        "multiple": true
      }
    ]
  },
  "config": {
    "type": "object",
    "additionalProperties": true,
    "properties": {}
  },
  "behavior": {
    "errorPolicy": {
      "default": "FAIL",
      "allowed": [
        "FAIL",
        "SKIP",
        "ERROR_PORT"
      ]
    },
    "concurrency": 1,
    "timeout": {
      "default": 60000
    }
  },
  "runtime": {
    "kind": "java",
    "handler": "com.eeip.node.control.ParallelNode",
    "state": "planned"
  },
  "compat": {
    "dsl": ">=1.0 <3.0",
    "engine": ">=0.7.0"
  },
  "permissions": [
    "node:PARALLEL"
  ]
}