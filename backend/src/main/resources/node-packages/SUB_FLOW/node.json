{
  "kind": "eeip/node",
  "apiVersion": "1.0",
  "type": "SUB_FLOW",
  "version": "1.0.0",
  "meta": {
    "category": "control",
    "displayName": {
      "zh-CN": "子流程",
      "zh-TW": "子流程",
      "en-US": "Subflow"
    },
    "color": "#5C6B78",
    "size": {
      "w": 160,
      "h": 58
    },
    "order": 76,
    "summary": "${config.flowCode}",
    "keywords": [
      "subflow",
      "子流程"
    ]
  },
  "ports": {
    "inputs": [
      {
        "id": "in",
        "type": "any"
      }
    ],
    "outputs": [
      {
        "id": "out",
        "type": "any"
      }
    ]
  },
  "config": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "flowCode"
    ],
    "properties": {
      "flowCode": {
        "type": "string",
        "title": "子流程编码",
        "x-eeip": {
          "labelKey": "designer.fSubflowCode",
          "widget": "flow-picker"
        }
      }
    }
  },
  "behavior": {
    "errorPolicy": {
      "default": "FAIL",
      "allowed": [
        "FAIL",
        "SKIP",
        "ERROR_PORT"
      ]
    },
    "concurrency": 1,
    "timeout": {
      "default": 60000
    }
  },
  "runtime": {
    "kind": "java",
    "handler": "com.eeip.node.control.SubFlowNode",
    "state": "planned"
  },
  "compat": {
    "dsl": ">=1.0 <3.0",
    "engine": ">=0.7.0"
  },
  "permissions": [
    "node:SUB_FLOW"
  ]
}